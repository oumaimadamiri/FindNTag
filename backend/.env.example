# Copiez ce fichier en backend/.env et remplissez-le. Ne commitez JAMAIS backend/.env.

# --- Base de données PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/animaltracking
DB_USER=animal
DB_PASSWORD=changez-moi

# --- Envoi des codes de vérification par email (compte Gmail avec « mot de passe d'application ») ---
MAIL_USERNAME=votre.adresse@gmail.com
MAIL_PASSWORD=mot-de-passe-application-google

# --- Sécurité : générez chaque secret avec  openssl rand -hex 32 ---
# Signature des jetons de connexion (au moins 32 caractères)
JWT_SECRET=
# Clé que le bridge MQTT envoie avec chaque position GPS (doit être identique dans mon_projet_mrz/.env)
GPS_INGEST_KEY=
# Durée de validité d'un jeton, en heures (7 jours par défaut)
# JWT_TTL_HOURS=168

# --- Services et fichiers ---
OCR_API_URL=http://localhost:5001/extract_info
UPLOAD_DIR=./uploads
CORS_ALLOWED_ORIGINS=http://localhost:8082,http://localhost:19006
