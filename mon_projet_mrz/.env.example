# --- Service OCR (app.py) ---
OCR_HOST=127.0.0.1
OCR_PORT=5001
OCR_GPU=false

# --- Bridge MQTT -> backend (mqtt_to_http_bridge.py) ---
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
# Un topic par traceur : gps_tracker/<deviceId>/location  (le deviceId se saisit dans l'application)
MQTT_TOPIC=gps_tracker/+/location
MQTT_USERNAME=
MQTT_PASSWORD=
# Pour un broker privé : MQTT_TLS=true et MQTT_PORT=8883
MQTT_TLS=false
BACKEND_URL=http://localhost:8081
# Doit être IDENTIQUE à GPS_INGEST_KEY dans backend/.env
GPS_INGEST_KEY=
