# Adresse du backend Spring Boot.
#  - IP du PC sur le Wi-Fi (commande : hostname -I)  ->  http://192.168.X.X:8081
#  - ou, téléphone branché en USB après `adb reverse tcp:8081 tcp:8081`  ->  http://localhost:8081
# Attention : c'est le port du BACKEND (8081), pas celui de Metro (8082).
EXPO_PUBLIC_API_URL=http://192.168.X.X:8081
