{
  "expo": {
    "name": "appmobile",
    "slug": "appmobile",
    "version": "1.0.0",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8B5CF6",
          "mode": "production",
          "androidMode": "collapse",
          "androidCollapsedTitle": "Nouvelles alertes"
        }
      ]
    ],
    "android": {
      "googleServicesFile": "./google-services.json",
      "useNextNotificationsApi": true,
      "permissions": ["RECEIVE_BOOT_COMPLETED"]
    },
    "extra": {
      "eas": {
        "projectId": "0fb9f178-24f1-4a0a-817b-a03e8690777e"
      }
    },

    "owner": "oumaimadmr"
  }
}
